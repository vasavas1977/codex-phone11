    <service
      android:name="ai.phone11.siprix.Phone11FirebaseMessagingService"
      android:enabled="false"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
