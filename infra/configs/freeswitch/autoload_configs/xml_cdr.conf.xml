<configuration name="xml_cdr.conf" description="XML CDR CURL logger">
  <settings>
    <!-- UNCOMMISSIONED: no HTTP destination or ordinary file logging by default.
         A reviewed private commissioning operation must inject together:
         http://127.0.0.1:3000/api/freeswitch/cdr, Basic phone11-cdr credentials,
         and a verified private persistent err-log-dir. Never commit credentials.
         The legacy generic deployment is intentionally blocked: it does not bind
         that private runtime configuration. Editing this tracked file cannot
         qualify a runtime mount; use the separately reviewed private operator.
         Native producer delivery remains a separate acceptance gate. -->
    <param name="url" value=""/>
    <param name="retries" value="0"/>
    <param name="timeout" value="3"/>
    <param name="delay" value="5"/>
    <param name="log-http-and-disk" value="false"/>
    <param name="log-b-leg" value="true"/>
    <param name="prefix-a-leg" value="true"/>
    <param name="encode" value="true"/>
    <!-- mod_xml_cdr uses Basic credentials; it does not inject a custom header. -->
    <param name="cred" value=""/>
    <param name="auth-scheme" value="basic"/>
    <!-- Include channel variables in CDR -->
    <param name="encode-values" value="true"/>
  </settings>
</configuration>
