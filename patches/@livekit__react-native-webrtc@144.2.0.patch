+package com.oney.WebRTCModule;
+
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executor;
+
+/** Native custody for one explicit, one-use consent; no application authority store. */
+final class Phone11ScreenTransaction<T> {
+    interface Resources<T> {
+        CompletableFuture<Void> startForeground();
+        T capture() throws Exception;
+        void disposeCapture() throws Exception;
+        CompletableFuture<Void> stopForeground();
+    }
+    final String operation;
+    final String lifetime;
+    private final Executor executor;
+    private final Resources<T> resources;
+    private final CompletableFuture<Void> consent = new CompletableFuture<>();
+    private final CompletableFuture<T> result = new CompletableFuture<>();
+    private final CompletableFuture<T> pipeline;
+    private volatile boolean retired;
+    private CompletableFuture<Void> stopping;
+    private boolean stopped;
+
+    Phone11ScreenTransaction(String operation, String lifetime, Executor executor, Resources<T> resources) {
+        this.operation = operation;
+        this.lifetime = lifetime;
+        this.executor = executor;
+        this.resources = resources;
+        pipeline = consent.thenComposeAsync(ignored -> {
+            requireCurrent();
+            return resources.startForeground();
+        }, executor).thenApplyAsync(ignored -> {
+            requireCurrent(); // A queued service acknowledgment cannot revive consent.
+            try {
+                T track = resources.capture();
+                requireCurrent();
+                return track;
+            } catch (Exception error) { throw new java.util.concurrent.CompletionException(error); }
+        }, executor);
+        pipeline.whenComplete((track, error) -> {
+            if (error != null) result.completeExceptionally(error);
+            else if (retired) result.completeExceptionally(new IllegalStateException("Screen operation retired"));
+            else result.complete(track);
+        });
+    }
+    boolean isRetired() { return retired; }
+    CompletableFuture<T> result() { return result; }
+    void grantConsent() { if (!retired) consent.complete(null); }
+    void refuseConsent() { retire(); }
+    void requireCurrent() {
+        if (retired) throw new IllegalStateException("Screen operation retired");
+    }
+    // Called at bridge entry, before queuing cleanup or waiting for a chooser.
+    void retire() {
+        retired = true;
+        IllegalStateException error = new IllegalStateException("Screen operation retired");
+        result.completeExceptionally(error);
+        consent.completeExceptionally(error);
+    }
+    synchronized CompletableFuture<Void> stop() {
+        retire();
+        if (stopped) return CompletableFuture.completedFuture(null);
+        if (stopping != null) return stopping;
+        // A startup already submitted to Android remains owned until it settles.
+        // A canceled chooser settles immediately; late results cannot start it.
+        CompletableFuture<Void> task = pipeline.handleAsync((track, error) -> {
+            try { resources.disposeCapture(); }
+            catch (Exception failure) { throw new java.util.concurrent.CompletionException(failure); }
+            return null;
+        }, executor).thenComposeAsync(ignored -> resources.stopForeground(), executor);
+        stopping = task;
+        task.whenComplete((ignored, error) -> {
+            synchronized (this) {
+                if (error == null) stopped = true;
+                if (stopping == task) stopping = null;
+            }
+        });
+        return task;
+    }
+}
