+            java.util.concurrent.atomic.AtomicBoolean started = new java.util.concurrent.atomic.AtomicBoolean();
+            capturer.initialize(texture, context, new CapturerObserver() {
+                @Override public void onCapturerStarted(boolean success) {
+                    observer.onCapturerStarted(success); started.set(success);
+                }
+                @Override public void onCapturerStopped() { observer.onCapturerStopped(); }
+                @Override public void onFrameCaptured(VideoFrame frame) { observer.onFrameCaptured(frame); }
+            });
