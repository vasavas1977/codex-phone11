+            info.putString("readyState", "live"); info.putBoolean("enabled", true); info.putBoolean("remote", false);
+            WritableMap settings = Arguments.createMap();
+            settings.putString("deviceId", "screen-capture"); settings.putInt("width", metrics.widthPixels);
