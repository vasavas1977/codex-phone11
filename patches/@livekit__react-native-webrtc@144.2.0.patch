+package com.oney.WebRTCModule;
+
+import android.app.Service;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.os.Build;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.BooleanSupplier;
+
+/** Separate from the released generic projection service; enabled only by owned build metadata. */
+public final class Phone11ScreenProjectionService extends Service {
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static Record active;
+    private Record owned;
+    static final class Record {
+        final String operation;
+        final BooleanSupplier retired;
+        final CompletableFuture<Void> started = new CompletableFuture<>();
+        final CompletableFuture<Void> destroyed = new CompletableFuture<>();
+        boolean requested;
+        Record(String operation, BooleanSupplier retired) { this.operation = operation; this.retired = retired; }
+    }
+    static synchronized Record prepare(String operation, BooleanSupplier retired) {
+        if (active != null) throw new IllegalStateException("Projection service cleanup pending");
+        Record record = new Record(operation, retired);
+        active = record;
+        return record;
+    }
+    static CompletableFuture<Void> launch(Context context, Record record) {
+        MAIN.post(() -> {
+            if (record.retired.getAsBoolean()) {
+                record.started.completeExceptionally(new IllegalStateException("Screen operation retired"));
+                return;
+            }
+            try {
+                MediaProjectionNotification.createNotificationChannel(context);
+                Intent intent = new Intent(context, Phone11ScreenProjectionService.class);
+                intent.putExtra("operation", record.operation);
+                ComponentName name = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
+                    ? context.startForegroundService(intent) : context.startService(intent);
+                if (name == null) throw new IllegalStateException("Projection service refused");
+                record.requested = true;
+            } catch (RuntimeException error) { record.started.completeExceptionally(error); }
+        });
+        MAIN.postDelayed(() -> record.started.completeExceptionally(
+            new IllegalStateException("Projection foreground acknowledgment timed out")), 8000);
+        return record.started;
+    }
+    static CompletableFuture<Void> stop(Context context, Record record) {
+        CompletableFuture<Void> attempt = new CompletableFuture<>();
+        record.destroyed.whenComplete((ignored, error) -> {
+            if (error != null) attempt.completeExceptionally(error); else attempt.complete(null);
+        });
+        MAIN.post(() -> {
+            // startForeground acknowledgment already settled before this call.
+            // A request actually submitted to Android needs onDestroy, never a boolean ACK.
+            if (!record.requested) {
+                record.destroyed.complete(null);
+                synchronized (Phone11ScreenProjectionService.class) { if (active == record) active = null; }
+                return;
+            }
+            try {
+                context.stopService(new Intent(context, Phone11ScreenProjectionService.class));
+            } catch (RuntimeException error) {
+                // Keep the record retryable: do not poison the eventual onDestroy receipt.
+                attempt.completeExceptionally(error);
+            }
+        });
+        MAIN.postDelayed(() -> attempt.completeExceptionally(
+            new IllegalStateException("Projection destruction acknowledgment timed out")), 8000);
+        return attempt;
+    }
+    @Override public void onCreate() {
+        super.onCreate();
+        // Capture custody even if Android destroys a queued start before onStartCommand.
+        synchronized (Phone11ScreenProjectionService.class) { owned = active; }
+    }
+    @Override public IBinder onBind(Intent intent) { return null; }
+    @Override public int onStartCommand(Intent intent, int flags, int startId) {
+        Record record;
+        synchronized (Phone11ScreenProjectionService.class) { record = active; }
+        if (record == null || owned != record || intent == null || !record.operation.equals(intent.getStringExtra("operation"))) {
+            stopSelf(); return START_NOT_STICKY;
+        }
+        owned = record;
+        if (record.retired.getAsBoolean()) {
+            record.started.completeExceptionally(new IllegalStateException("Screen operation retired"));
+            stopSelf(); return START_NOT_STICKY;
+        }
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q)
+                startForeground(MediaProjectionService.NOTIFICATION_ID,
+                    MediaProjectionNotification.buildMediaProjectionNotification(this),
+                    ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION);
+            else startForeground(MediaProjectionService.NOTIFICATION_ID,
+                MediaProjectionNotification.buildMediaProjectionNotification(this));
+            if (record.retired.getAsBoolean()) {
+                record.started.completeExceptionally(new IllegalStateException("Screen operation retired"));
+                stopSelf();
+            } else record.started.complete(null);
+        } catch (RuntimeException error) {
+            record.started.completeExceptionally(error);
+            stopSelf();
+        }
+        return START_NOT_STICKY;
+    }
+    @Override public void onDestroy() {
+        super.onDestroy();
+        Record record = owned;
+        if (record != null) {
+            record.started.completeExceptionally(new IllegalStateException("Projection service stopped"));
+            record.destroyed.complete(null);
+            synchronized (Phone11ScreenProjectionService.class) { if (active == record) active = null; }
+        }
+    }
+}
