+        consentResult = null;
+        stop(transaction, promise);
+    }
+    private void retire(Phone11ScreenTransaction<WritableMap> transaction) {
+        transaction.retire();
+        if (active == transaction) consentResult = null;
+        stop(transaction, null);
+    }
+    private void stop(Phone11ScreenTransaction<WritableMap> transaction, Promise promise) {
+        transaction.stop().whenComplete((ignored, error) -> {
+            if (error == null) {
+                ThreadUtils.runOnExecutor(() -> {
+                    if (active == transaction) {
+                        active = null; resources = null; consentActivity = null; consentRequest = -1; awaitingChooser = false;
+                        if (custody == this) custody = null;
+                    }
+                    if (promise != null) promise.resolve(null);
+                });
