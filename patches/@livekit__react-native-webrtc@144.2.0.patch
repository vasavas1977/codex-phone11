+                @Override public void onStop() {
+                    new TrackCapturerEventsEmitter(module, trackId).onCapturerEnded();
+                    retire(transaction);
+                }
+            });
+            texture = SurfaceTextureHelper.create("Phone11ScreenCapture", EglUtils.getRootEglBaseContext());
+            if (texture == null) throw new IllegalStateException("Capture surface unavailable");
+            source = module.mFactory.createVideoSource(true);
