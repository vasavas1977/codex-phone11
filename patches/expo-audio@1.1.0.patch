diff --git a/android/src/main/java/expo/modules/audio/PlaybackAudioRouting.kt b/android/src/main/java/expo/modules/audio/PlaybackAudioRouting.kt
new file mode 100644
index 0000000000000000000000000000000000000000..520ca5b7cb0bb3901849e3de95fde52f01e1c281
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/PlaybackAudioRouting.kt
@@ -0,0 +1,118 @@
+package expo.modules.audio
+
+import android.content.Context
+import android.media.AudioDeviceCallback
+import android.media.AudioDeviceInfo
+import android.media.AudioManager
+import android.media.AudioRouting
+import android.media.AudioTrack
+import android.os.Handler
+import android.os.Looper
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.audio.ForwardingAudioSink
+import androidx.media3.exoplayer.audio.AudioSink
+import androidx.media3.exoplayer.audio.DefaultAudioSink
+
+/** Observe this player's AudioTrack, never a requested route or the SIP communication device. */
+@UnstableApi
+class PlaybackAudioRouting(private val context: Context) {
+  val state = PlaybackRouteState()
+  private val handler = Handler(Looper.getMainLooper())
+  private val audio = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+  private var track: AudioTrack? = null
+  private var receiverRequested = false
+  private var installedGeneration = -1
+  @Volatile private var closed = false
+  var changed: (() -> Unit)? = null
+  private val listener = AudioRouting.OnRoutingChangedListener { source -> handler.post { if (!closed && source === track && installedGeneration == state.generation()) changed?.invoke() } }
+
+  private val deviceListener = object : AudioDeviceCallback() {
+    override fun onAudioDevicesAdded(devices: Array<AudioDeviceInfo>) { if (!closed) changed?.invoke() }
+    override fun onAudioDevicesRemoved(devices: Array<AudioDeviceInfo>) { if (!closed) changed?.invoke() }
+  }
+  init { audio.registerAudioDeviceCallback(deviceListener, handler) }
+
+  fun renderersFactory() = object : DefaultRenderersFactory(context) {
+    override fun buildAudioSink(context: Context, enableFloatOutput: Boolean, enableAudioTrackPlaybackParams: Boolean): AudioSink {
+      lateinit var sink: DefaultAudioSink
+      sink = DefaultAudioSink.Builder(context)
+        .setEnableFloatOutput(enableFloatOutput)
+        .setEnableAudioTrackPlaybackParams(enableAudioTrackPlaybackParams)
+        .setAudioTrackProvider { config, attributes, sessionId, trackContext ->
+          // This runs on ExoPlayer's audio thread before the new track can play.
+          val generation = state.replacingTrack()
+          if (state.waiting()) sink.setVolume(0f)
+          val next = DefaultAudioSink.AudioTrackProvider.DEFAULT.getAudioTrack(config, attributes, sessionId, trackContext)
+          handler.post {
+            if (!closed && generation == state.generation()) {
+              track?.removeOnRoutingChangedListener(listener)
+              track = next
+              installedGeneration = generation
+              next.addOnRoutingChangedListener(listener, handler)
+              changed?.invoke()
+            }
+          }
+          next
+        }.build()
+      return object : ForwardingAudioSink(sink) {
+        override fun setVolume(volume: Float) { super.setVolume(state.effectiveVolume(volume)) }
+      }
+    }
+  }
+
+  fun devices(): List<AudioDeviceInfo> = audio.getDevices(AudioManager.GET_DEVICES_OUTPUTS).toList()
+  fun expectReceiver(route: String) { receiverRequested = route == "earpiece" }
+
+  fun target(route: String): AudioDeviceInfo? {
+    if (route == "system") return null
+    val type = when (route) {
+      "earpiece" -> AudioDeviceInfo.TYPE_BUILTIN_EARPIECE
+      "speaker" -> AudioDeviceInfo.TYPE_BUILTIN_SPEAKER
+      else -> throw IllegalArgumentException("PLAYBACK_ROUTE_UNAVAILABLE")
+    }
+    return devices().firstOrNull { it.type == type } ?: throw IllegalStateException("PLAYBACK_ROUTE_UNAVAILABLE")
+  }
+
+  fun status(): Map<String, Any?> {
+    val observedGeneration = state.generation()
+    val current = try { track?.takeIf {
+      installedGeneration == observedGeneration &&
+      it.playState == AudioTrack.PLAYSTATE_PLAYING && (!receiverRequested ||
+        (it.audioAttributes.usage == android.media.AudioAttributes.USAGE_VOICE_COMMUNICATION &&
+          it.preferredDevice?.type == AudioDeviceInfo.TYPE_BUILTIN_EARPIECE))
+    }?.routedDevice } catch (_: IllegalStateException) { null }
+    val route = when (current?.type) {
+      null -> "unknown"
+      AudioDeviceInfo.TYPE_BUILTIN_EARPIECE -> "earpiece"
+      AudioDeviceInfo.TYPE_BUILTIN_SPEAKER -> "speaker"
+      else -> "external"
+    }
+    val label = when (current?.type) {
+      AudioDeviceInfo.TYPE_BUILTIN_EARPIECE -> "Earpiece"
+      AudioDeviceInfo.TYPE_BUILTIN_SPEAKER -> "Speaker"
+      AudioDeviceInfo.TYPE_BLUETOOTH_A2DP, AudioDeviceInfo.TYPE_BLUETOOTH_SCO,
+      AudioDeviceInfo.TYPE_BLE_HEADSET, AudioDeviceInfo.TYPE_BLE_SPEAKER, AudioDeviceInfo.TYPE_HEARING_AID -> "Bluetooth"
+      AudioDeviceInfo.TYPE_WIRED_HEADPHONES, AudioDeviceInfo.TYPE_WIRED_HEADSET -> "Headphones"
+      AudioDeviceInfo.TYPE_USB_DEVICE, AudioDeviceInfo.TYPE_USB_HEADSET -> "USB audio"
+      AudioDeviceInfo.TYPE_HDMI, AudioDeviceInfo.TYPE_HDMI_ARC, AudioDeviceInfo.TYPE_HDMI_EARC -> "HDMI"
+      null -> "Audio output"
+      else -> "Connected audio"
+    }
+    val available = devices()
+    val routes = mutableListOf("system")
+    if (available.any { it.type == AudioDeviceInfo.TYPE_BUILTIN_EARPIECE }) routes.add("earpiece")
+    if (available.any { it.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER }) routes.add("speaker")
+    return mapOf("route" to route, "label" to label, "availableRoutes" to routes, "_generation" to observedGeneration)
+  }
+
+  fun close() {
+    closed = true
+    changed = null
+    handler.post {
+      audio.unregisterAudioDeviceCallback(deviceListener)
+      track?.removeOnRoutingChangedListener(listener)
+      track = null
+    }
+  }
+}
