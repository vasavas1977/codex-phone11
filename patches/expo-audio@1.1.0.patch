index 0000000000000000000000000000000000000000..b7c717894c857070e155083ff5e0f96576bc9e35
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/PlaybackRouteState.java
@@ -0,0 +1,56 @@
+package expo.modules.audio;
+
+/** Pure per-player state; no global Android audio or calling state is changed. */
+public final class PlaybackRouteState {
+  private String preference = "system";
+  private Float desiredVolume;
+  private int epoch, generation;
+  private float lastVolume = 1f;
+  private boolean configured, released;
+  public synchronized float select(String route, float volume) {
+    if (released || !(route.equals("earpiece") || route.equals("speaker") || route.equals("system")))
+      throw new IllegalStateException("PLAYBACK_ROUTE_UNAVAILABLE");
+    lastVolume = desiredVolume == null ? volume : desiredVolume;
+    configured = true;
+    preference = route;
+    ++epoch;
+    if (route.equals("earpiece")) {
+      if (desiredVolume == null) desiredVolume = volume;
+      return 0f;
+    }
+    float restore = desiredVolume == null ? volume : desiredVolume;
+    desiredVolume = null;
+    return restore;
+  }
+  public synchronized float observe(String route, float volume) { return observe(route, volume, generation); }
+  public synchronized float observe(String route, float volume, int observedGeneration) {
+    if (observedGeneration != generation) return effectiveVolume(volume);
+    if (released || !preference.equals("earpiece")) return volume;
+    if (route.equals("earpiece") || route.equals("external")) {
+      float restore = desiredVolume == null ? volume : desiredVolume;
+      desiredVolume = null;
+      lastVolume = restore;
+      return restore;
+    }
+    if (desiredVolume == null) desiredVolume = volume;
+    return 0f;
+  }
+  public synchronized boolean rejected(String actual) { return !released && preference.equals("earpiece") && actual.equals("speaker"); }
+  public synchronized boolean waiting() { return !released && desiredVolume != null; }
+  public synchronized int replacingTrack() {
+    ++generation;
+    if (!released && preference.equals("earpiece") && desiredVolume == null) desiredVolume = lastVolume;
+    return generation;
+  }
+  public synchronized int generation() { return generation; }
+  public synchronized float effectiveVolume(float requested) { return waiting() || released ? 0f : requested; }
+  public synchronized float changeVolume(float requested) {
+    lastVolume = requested;
+    if (desiredVolume != null) { desiredVolume = requested; return 0f; }
+    return requested;
+  }
+  public synchronized int epoch() { return epoch; }
+  public synchronized boolean released() { return released; }
+  public synchronized boolean autoResume(boolean wasPaused) { return wasPaused && !configured && !released; }
+  public synchronized void close() { released = true; ++epoch; desiredVolume = null; }
+}
