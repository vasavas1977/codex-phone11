{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      }
    },
    "development-ios-existing-credentials": {
      "extends": "development",
      "env": {
        "PHONE11_BUNDLE_ID": "space.manus.phone11ai.t20260425073427",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.phone11.ai",
        "EXPO_PUBLIC_DEEP_LINK_SCHEME": "phone11"
      },
      "ios": {
        "image": "latest"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "preview-ios-existing-credentials": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "PHONE11_BUNDLE_ID": "space.manus.phone11ai.t20260425073427",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.phone11.ai",
        "EXPO_PUBLIC_DEEP_LINK_SCHEME": "phone11"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    },
    "preview-ios-siprix": {
      "extends": "preview-ios-existing-credentials",
      "channel": "siprix-trial",
      "env": {
        "EXPO_PUBLIC_SIP_ENGINE": "siprix",
        "PHONE11_VOIP_WAKE_COMMISSIONED": "0",
        "PHONE11_CHAT_NOTIFICATIONS_COMMISSIONED": "0"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    },
    "preview-ios-siprix-wake-pilot": {
      "extends": "preview-ios-siprix",
      "channel": "siprix-wake-pilot",
      "env": {
        "PHONE11_VOIP_WAKE_COMMISSIONED": "1",
        "PHONE11_APNS_ENVIRONMENT": "production"
      }
    },
    "preview-ios-siprix-daily-pilot": {
      "extends": "preview-ios-siprix-wake-pilot",
      "channel": "siprix-daily-pilot",
      "env": {
        "PHONE11_CHAT_NOTIFICATIONS_COMMISSIONED": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
