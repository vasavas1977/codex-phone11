  def test_extra_select_or_dml_or_sequence_authority_is_refused(self):
   for grant,revoke,index in [('GRANT SELECT(synthetic_ungranted)ON tenants TO did_reader','REVOKE SELECT(synthetic_ungranted)ON tenants FROM did_reader',2),('GRANT UPDATE(status)ON tenants TO did_reader','REVOKE UPDATE(status)ON tenants FROM did_reader',2),('CREATE SEQUENCE did_forbidden;GRANT USAGE ON SEQUENCE did_forbidden TO did_reader','DROP SEQUENCE did_forbidden',4)]:
    with self.subTest(grant=grant):self.sql(grant+';').check_returncode();self.assertEqual(self.gate()[index],'f');self.sql(revoke+';').check_returncode()
+ def test_delete_only_unrelated_view_authority_is_refused_for_role_and_public(self):
+  self.sql('CREATE VIEW public.did_delete_view AS SELECT id FROM tenants;GRANT DELETE ON public.did_delete_view TO did_reader;').check_returncode()
+  self.assertEqual(self.gate()[3],'f')
+  self.sql('REVOKE DELETE ON public.did_delete_view FROM did_reader;GRANT DELETE ON public.did_delete_view TO PUBLIC;').check_returncode()
+  self.assertEqual(self.gate()[3],'f')
  def test_missing_required_column_rls_or_executable_definer_is_refused(self):
   self.sql('ALTER TABLE tenants ENABLE ROW LEVEL SECURITY;').check_returncode();self.assertEqual(self.gate()[0],'f');self.sql('ALTER TABLE tenants DISABLE ROW LEVEL SECURITY;').check_returncode()
   self.sql("CREATE FUNCTION public.did_forbidden()RETURNS integer LANGUAGE sql SECURITY DEFINER AS $$SELECT 1$$;").check_returncode();self.assertEqual(self.gate()[5],'f');self.sql('DROP FUNCTION public.did_forbidden();ALTER TABLE tenants DROP COLUMN status;').check_returncode();self.assertEqual(self.gate()[1],'f')
